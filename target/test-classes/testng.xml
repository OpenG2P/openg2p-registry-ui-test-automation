<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Social Registry Sanity Test Suite" parallel="classes" thread-count="4">

    <listeners>
        <listener class-name="listeners.TestListener"/>
        <listener class-name="listeners.RetryListener"/>
    </listeners>

    <test verbose="2" preserve-order="true" name="Sanity Suite">
        <classes>
            <class name="testcase.LoginPageTest"/>
            <class name="testcase.IndividualTest"/>
            <class name="testcase.GroupTest"/>
            <class name="testcase.GenderTypeTest"/>
            <class name="testcase.GroupMembershipKindTest"/>
            <class name="testcase.GroupTypeTest"/>
            <class name="testcase.IdTypeTest"/>
            <class name="testcase.RegionTest"/>
            <class name="testcase.RegistrantTagsTest"/>
            <class name="testcase.RelationshipTest"/>
            <class name="testcase.DistrictConfigTest"/>
        </classes>
    </test>
</suite>
